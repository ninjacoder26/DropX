# ─── DropX SERVER-ONLY environment ─────────────────────────────
# This file holds PRIVATE secrets used exclusively by server code
# (Vercel serverless functions in /api and backend automation).
#
# NOTHING in this file is ever bundled into the browser JavaScript.
# Public client values (Supabase URL + anon key, Cloudinary cloud name +
# upload preset) live in src/config.ts instead — the anon key is designed
# to be public; Row Level Security protects the data.
#
# Copy to `.env` locally (never commit `.env`), and set the same keys in
# the Vercel dashboard for production. Placeholders only below.

# Supabase service-role key — bypasses RLS. SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary server credentials — signing uploads + deleting assets. SERVER ONLY.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
